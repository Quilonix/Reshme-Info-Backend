# ==============================================================================
# Reshme Info: Next.js Admin Portal Environment Template
# ==============================================================================

# Public Supabase Client (Browser safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase Service Role Key (Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Analytics 4 Configuration
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_PROPERTY_ID=123456789

# Redis Cache Configuration (Upstash Serverless Redis REST API)
UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token
REDIS_URL=redis://default:password@your-redis-host:6379

# Firebase Admin SDK Service Account Key (Paste the JSON string from Firebase Console)
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id",...}

# Server-only AI Provider Keys for Market Report Extraction
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
